{
  "name": "aosp-ide-vscode",
  "displayName": "AOSP Workspace",
  "description": "Focused AOSP navigation and cross-language indexing.",
  "version": "0.1.0-dev",
  "publisher": "rtfsc",
  "license": "Apache-2.0",
  "engines": {
    "vscode": ">=1.90.0"
  },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": [
    "workspaceContains:**/Android.bp",
    "workspaceContains:**/Android.mk",
    "workspaceContains:build/envsetup.sh",
    "workspaceContains:build/soong",
    "workspaceContains:soong/soong_ui.bash",
    "onView:aospWorkspace.setup",
    "onLanguage:aidl",
    "onCommand:aospIde.goToJniPeer",
    "onCommand:aospIde.goToAidlGeneratedPeer",
    "onCommand:aospIde.refreshCompdbOverlay",
    "onCommand:aospIde.showStatus"
    ,"onCommand:aospIde.openProfile"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "aospWorkspace", "title": "AOSP Workspace", "icon": "resources/aosp-ide.svg" }] },
    "views": { "aospWorkspace": [{ "id": "aospWorkspace.setup", "name": "Workspace Setup", "type": "webview" }] },
    "configuration": {
      "title": "AOSP Workspace",
      "properties": {
        "aospIde.engineExecutable": {
          "type": "string",
          "default": "",
          "description": "Optional path to aosp-index. Bundled engine and PATH are used when empty."
        },
        "aospIde.workspaceViewRoot": {
          "type": "string",
          "default": "",
          "description": "Workspace View root containing selected AOSP repositories."
        },
        "aospIde.outRoot": {
          "type": "string",
          "default": "",
          "description": "AOSP out or metadata root containing compile_commands.json."
        },
        "aospIde.targets": {
          "type": "array",
          "default": [],
          "description": "TargetSpec objects for Framework, Services, SystemUI, and custom targets.",
          "items": { "type": "object" }
        },
        "aospIde.selectedModules": {
          "type": "array",
          "default": [],
          "description": "Workspace-local module selections discovered from Android.bp.",
          "items": { "type": "string" }
        },
        "aospIde.pathMappings": {
          "type": "array",
          "default": [],
          "description": "Build-host to local path mappings.",
          "items": { "type": "object" }
        }
      }
    },
    "commands": [
      {
        "command": "aospIde.goToJniPeer",
        "title": "AOSP: Go to JNI Peer"
      },
      {
        "command": "aospIde.goToAidlGeneratedPeer",
        "title": "AOSP: Go to AIDL Generated Peer"
      },
      {
        "command": "aospIde.refreshCompdbOverlay",
        "title": "AOSP: Refresh clangd Compilation Database"
      },
      {
        "command": "aospIde.showStatus",
        "title": "AOSP: Show Status"
      },
      {
        "command": "aospIde.openProfile",
        "title": "AOSP Workspace: Configure Profile"
      },
      {
        "command": "aospIde.refreshModules",
        "title": "AOSP Workspace: Refresh Modules"
      }
    ],
    "languages": [
      {
        "id": "aidl",
        "aliases": ["AIDL"],
        "extensions": [".aidl"]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "check": "npm run compile && node --test out/engine/*.test.js out/navigation/*.test.js",
    "host-test": "npm run compile && node ./test/run-host-test.js",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.2.0",
    "@vscode/test-electron": "^3.1.0"
  }
}
