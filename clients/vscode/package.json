{
  "name": "aosp-ide-vscode",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0-dev",
  "publisher": "rtfsc",
  "license": "Apache-2.0",
  "engines": {
    "vscode": ">=1.90.0"
  },
  "categories": ["Programming Languages", "Other"],
  "activationEvents": [
    "workspaceContains:**/Android.bp",
    "workspaceContains:**/Android.mk",
    "workspaceContains:build/envsetup.sh",
    "workspaceContains:build/soong",
    "workspaceContains:soong/soong_ui.bash",
    "onView:aospWorkspace.setup",
    "onLanguage:aidl",
    "onCommand:aospIde.goToJniPeer",
    "onCommand:aospIde.goToAidlGeneratedPeer",
    "onCommand:aospIde.refreshCompdbOverlay",
    "onCommand:aospIde.showStatus"
    ,"onCommand:aospIde.openProfile"
  ],
  "main": "./out/extension.js",
  "l10n": "./l10n",
  "contributes": {
    "viewsContainers": { "activitybar": [{ "id": "aospWorkspace", "title": "AOSP Workspace", "icon": "resources/aosp-ide.svg" }] },
    "views": { "aospWorkspace": [{ "id": "aospWorkspace.setup", "name": "%view.workspaceSetup%", "type": "webview" }] },
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "aospIde.engineExecutable": {
          "type": "string",
          "default": "",
          "description": "%configuration.engineExecutable%"
        },
        "aospIde.workspaceViewRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.workspaceViewRoot%"
        },
        "aospIde.outRoot": {
          "type": "string",
          "default": "",
          "description": "%configuration.outRoot%"
        },
        "aospIde.targets": {
          "type": "array",
          "default": [],
          "description": "%configuration.targets%",
          "items": { "type": "object" }
        },
        "aospIde.selectedPresets": {
          "type": "array",
          "default": [],
          "description": "%configuration.selectedPresets%",
          "items": { "type": "string" }
        },
        "aospIde.selectedModules": {
          "type": "array",
          "default": [],
          "description": "%configuration.selectedModules%",
          "items": { "type": "string" }
        },
        "aospIde.pathMappings": {
          "type": "array",
          "default": [],
          "description": "%configuration.pathMappings%",
          "items": { "type": "object" }
        }
      }
    },
    "commands": [
      {
        "command": "aospIde.goToJniPeer",
        "title": "%command.jniPeer%"
      },
      {
        "command": "aospIde.goToAidlGeneratedPeer",
        "title": "%command.aidlPeer%"
      },
      {
        "command": "aospIde.refreshCompdbOverlay",
        "title": "%command.compdb%"
      },
      {
        "command": "aospIde.showStatus",
        "title": "%command.status%"
      },
      {
        "command": "aospIde.openProfile",
        "title": "%command.configure%"
      },
      {
        "command": "aospIde.checkDependencies",
        "title": "%command.checkDependencies%"
      },
      {
        "command": "aospIde.refreshModules",
        "title": "%command.refreshModules%"
      }
    ],
    "languages": [
      {
        "id": "aidl",
        "aliases": ["AIDL"],
        "extensions": [".aidl"]
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./tsconfig.json",
    "check": "npm run compile && node --test out/engine/*.test.js out/navigation/*.test.js",
    "host-test": "npm run compile && node ./test/run-host-test.js",
    "package": "npm run compile && vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "typescript": "^5.6.0",
    "@vscode/vsce": "^3.2.0",
    "@vscode/test-electron": "^3.1.0"
  }
}
