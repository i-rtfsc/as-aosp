<idea-plugin>
    <id>com.rtfsc.aosp</id>
    <name>AOSP IDE</name>
    <vendor>AOSP IDE contributors</vendor>
    <description><![CDATA[
        Focused AOSP source navigation and cross-language indexing.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="AIDL" language="AIDL" implementationClass="com.rtfsc.aosp.aidl.AidlFileType" extensions="aidl"/>
        <gotoDeclarationHandler language="AIDL" implementationClass="com.rtfsc.aosp.aidl.AidlGotoDeclarationHandler"/>
        <projectConfigurable instance="com.rtfsc.aosp.profile.ProfileConfigurable"/>
        <projectService serviceImplementation="com.rtfsc.aosp.project.FocusedRootsService"/>
    </extensions>
    <actions>
        <action id="com.rtfsc.aosp.aidlDefinition" class="com.rtfsc.aosp.aidl.AidlDefinitionAction" text="Go to AIDL Definition">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
        <action id="com.rtfsc.aosp.jniPeer" class="com.rtfsc.aosp.jni.JniPeerAction" text="Go to JNI Peer">
            <add-to-group group-id="EditorPopupMenu" anchor="last"/>
        </action>
    </actions>
</idea-plugin>
