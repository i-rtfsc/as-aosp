<idea-plugin>
    <id>com.rtfsc.aosp</id>
    <name>AOSP IDE</name>
    <vendor>AOSP IDE contributors</vendor>
    <description><![CDATA[
        Focused AOSP source navigation and cross-language indexing.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <extensions defaultExtensionNs="com.intellij">
        <projectConfigurable instance="com.rtfsc.aosp.profile.ProfileConfigurable"/>
        <projectService serviceImplementation="com.rtfsc.aosp.project.FocusedRootsService"/>
    </extensions>
</idea-plugin>
