{
  "schemaVersion": 1,
  "id": "source-only-fixture",
  "workspaceViewRoot": "testdata/source-only/view",
  "canonicalRepoRoot": "testdata/source-only/full-aosp",
  "scope": {
    "mode": "selected-repositories",
    "include": ["frameworks/base"]
  },
  "targets": [
    {
      "id": "framework-source",
      "displayName": "Framework source",
      "kind": "java",
      "selectors": {
        "sourceRoots": ["frameworks/base"]
      },
      "includeDependencies": false,
      "includeGeneratedSources": false
    }
  ],
  "visibilityPolicy": {
    "mode": "strict-view",
    "allowOpenExternalFile": true,
    "confirmBeforeExpanding": true
  }
}
